{
  "name": "runmotion-3d",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:browser": "node scripts/browser.mjs",
    "test:gate": "node scripts/gate.mjs",
    "format": "prettier --write src tests scripts vite.config.ts",
    "test:camera": "node scripts/browser.mjs --camera",
    "test:regression": "node scripts/browser.mjs --milestone-2",
    "test:social": "node scripts/browser.mjs --social",
    "test:styles": "node scripts/browser.mjs --styles",
    "test:overlays": "node scripts/browser.mjs --overlays"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.218.0",
    "mediabunny": "1.61.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "playwright": "1.62.1",
    "prettier": "3.9.10"
  }
}
